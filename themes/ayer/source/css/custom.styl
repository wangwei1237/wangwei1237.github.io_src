$wrap-width = convert(hexo-config('layout.article_width'))
$aside-width = convert(hexo-config('layout.sidebar_width'))
$mouse-url = convert(hexo-config('mouse.path'))

if hexo-config('mouse.enable')
    body
        cursor: url($mouse-url),auto;

.sidebar
    left - $aside-width
    width $aside-width
    &.on
        left 0
.content
    &.on
        margin-left 0 !important
.navbar-toggle
    left 1.5rem + $aside-width
.search-form-wrap
    right $aside-width

@media(min-width: 768px)
    .outer, .wrap
        width $wrap-width !important
@media(max-width: 768px)
    .tocbot
        display none !important
    .sidebar
        left 0
        &.on
            left - $aside-width
    .content
        transform translateX($aside-width)
        &.on
            transform translateX(0)
    
.has-jax
    border-spacing 0
    table-layout fixed
    word-wrap break-word
    word-break break-all
    overflow-x auto
    overflow-y hidden

// pele 图表样式(https://pele.run/theming)
if hexo-config('pele.enable')
    @css {
        .pele-diagram {
            margin: 10px 0;
            padding: 10px;
            background: #ffffff;
            overflow: hidden;
        }
        body.darkmode .pele-diagram {
            --pele-bg: #100f0f;
            --pele-fg: #cecdc3;
            --pele-muted: #878580;
            --pele-line: #cecdc3;
            --pele-surface: #1c1b1a;
            --pele-surface-alt: #282726;
            --pele-border: #403e3c;
            --pele-accent: #4385be;
            --pele-critical: #d14d41;
            background: #100f0f;
        }
    }
